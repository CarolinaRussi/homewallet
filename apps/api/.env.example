# Copy to apps/api/.env and fill values there. Never commit .env.
# See README for how to obtain each value (Neon/Docker, Resend, Google).

DATABASE_URL=
JWT_SECRET=
WEB_ORIGIN=
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
