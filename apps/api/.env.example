# Copy to apps/api/.env and fill in. Never commit .env.
#
# Neon: paste the connection string from the Neon console (keep sslmode=require).
# Or local Docker after `docker compose up -d` — see README for the local URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/homewallet
JWT_SECRET=change-me-in-dev
WEB_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=
# Optional locally: leave RESEND_API_KEY empty to log reset/invite links in the API console
RESEND_API_KEY=
RESEND_FROM=HomeWallet <onboarding@resend.dev>
